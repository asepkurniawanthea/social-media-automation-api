{
  "info": {
    "_postman_id": "4c8b4f1a-d929-4bfd-9c9b-e2edfc97d6e9",
    "name": "Social Media Automation API",
    "description": "CRUD test collection for the Sources API. Run the requests in order: Create, List, Get, Update, then Delete.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3100"
    },
    {
      "key": "sourceId",
      "value": ""
    },
    {
      "key": "sourceDomain",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sources",
      "item": [
        {
          "name": "Create source",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uniqueId = Date.now();",
                  "pm.collectionVariables.set('sourceDomain', `example-${uniqueId}.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                  "const source = pm.response.json();",
                  "pm.test('Response contains created source', () => {",
                  "  pm.expect(source).to.have.property('id').that.is.a('number');",
                  "  pm.expect(source.domain).to.eql(pm.collectionVariables.get('sourceDomain'));",
                  "  pm.expect(source.channel).to.eql('hardcode');",
                  "  pm.expect(source.is_active).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set('sourceId', source.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"domain\": \"{{sourceDomain}}\",\n  \"name\": \"Postman Test Source\",\n  \"channel\": \"hardcode\",\n  \"is_active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/sources"
          }
        },
        {
          "name": "List sources",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const sources = pm.response.json();",
                  "pm.test('Response is an array', () => pm.expect(sources).to.be.an('array'));",
                  "pm.test('Created source appears in list', () => {",
                  "  const sourceId = Number(pm.collectionVariables.get('sourceId'));",
                  "  pm.expect(sources.some((source) => source.id === sourceId)).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/sources"
          }
        },
        {
          "name": "Get source by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const source = pm.response.json();",
                  "pm.test('Response matches requested source', () => {",
                  "  pm.expect(source.id).to.eql(Number(pm.collectionVariables.get('sourceId')));",
                  "  pm.expect(source.domain).to.eql(pm.collectionVariables.get('sourceDomain'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/sources/{{sourceId}}"
          }
        },
        {
          "name": "Update source",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const source = pm.response.json();",
                  "pm.test('Source is updated', () => {",
                  "  pm.expect(source.name).to.eql('Postman Updated Source');",
                  "  pm.expect(source.channel).to.eql('ngabring');",
                  "  pm.expect(source.is_active).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Updated Source\",\n  \"channel\": \"ngabring\",\n  \"is_active\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/sources/{{sourceId}}"
          }
        },
        {
          "name": "Delete source",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const source = pm.response.json();",
                  "pm.test('Deleted source is returned', () => {",
                  "  pm.expect(source.id).to.eql(Number(pm.collectionVariables.get('sourceId')));",
                  "});",
                  "pm.collectionVariables.unset('sourceId');",
                  "pm.collectionVariables.unset('sourceDomain');"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/sources/{{sourceId}}"
          }
        }
      ]
    }
  ]
}
